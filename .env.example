# OpenRouter (https://openrouter.ai/settings/keys) — free models via openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLAlchemy URL. SQLite is the default; Postgres works by swapping this string.
DATABASE_URL=sqlite:///./trips.db

# Browser origin allowed by CORS. Use * on a demo deploy; lock to the Vercel URL in production.
FRONTEND_ORIGIN=*
