# OpenRouter (https://openrouter.ai/settings/keys) — free models via openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLAlchemy URL. SQLite is the default; Postgres works by swapping this string.
DATABASE_URL=sqlite:///./trips.db

# Browser origin allowed by CORS. Comma-separated if UI and previews differ.
# Local: *
# Vercel API project: https://your-frontend.vercel.app
FRONTEND_ORIGIN=*
